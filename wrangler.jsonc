{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "omar-portfolio",
  "main": "src/worker.mjs",
  "compatibility_date": "2026-09-11",
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "html_handling": "force-trailing-slash",
    "run_worker_first": true
  },
  "routes": [
    {
      "pattern": "omaryusuf.se",
      "custom_domain": true
    },
    {
      "pattern": "www.omaryusuf.se",
      "custom_domain": true
    }
  ],
  "analytics_engine_datasets": [
    {
      "binding": "ANALYTICS",
      "dataset": "omaryusuf_events"
    }
  ],
  "images": { "binding": "CMS_IMAGES" },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "logs": { "invocation_logs": false }
  },
  "vars": {
    "ANALYTICS_ENABLED": "false"
  },
  "ratelimits": [
    {
      "name": "CONTACT_RATE_LIMIT",
      "namespace_id": "73142026",
      "simple": {
        "limit": 5,
        "period": 60
      }
    }
  ]
}
