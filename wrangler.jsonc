{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "omar-portfolio",
  "main": "src/worker.mjs",
  "compatibility_date": "2026-09-11",
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "html_handling": "force-trailing-slash",
    "run_worker_first": true
  },
  "routes": [
    {
      "pattern": "omaryusuf.se",
      "custom_domain": true
    },
    {
      "pattern": "www.omaryusuf.se",
      "custom_domain": true
    }
  ],
  "d1_databases": [
    {
      "binding": "CMS_DB",
      "database_name": "omar-portfolio-cms-staging",
      "database_id": "07048c08-64ee-413d-ae08-2ec947c533ae",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "CMS_MEDIA",
      "bucket_name": "omar-portfolio-cms-staging"
    }
  ],
  "analytics_engine_datasets": [
    {
      "binding": "ANALYTICS",
      "dataset": "omaryusuf_events"
    }
  ],
  "images": {
    "binding": "CMS_IMAGES"
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "logs": {
      "invocation_logs": false
    }
  },
  "vars": {
    "ANALYTICS_ENABLED": "false",
    "CMS_ACCESS_TEAM": "https://dark-scene-be27.cloudflareaccess.com",
    "CMS_ACCESS_AUD": "90e4fe0941b104c6243a41081a9c2723001209c3aa6a61435ec07fdf348e61ac"
  },
  "ratelimits": [
    {
      "name": "CONTACT_RATE_LIMIT",
      "namespace_id": "73142026",
      "simple": {
        "limit": 5,
        "period": 60
      }
    }
  ]
}
