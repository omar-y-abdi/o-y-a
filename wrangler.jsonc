{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "omaryusuf-se",
  "main": "src/worker.mjs",
  "compatibility_date": "2026-09-11",
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "html_handling": "force-trailing-slash",
    "run_worker_first": true
  },
  "routes": [
    {
      "pattern": "omaryusuf.se",
      "custom_domain": true
    },
    {
      "pattern": "www.omaryusuf.se",
      "custom_domain": true
    }
  ],
  "analytics_engine_datasets": [
    {
      "binding": "ANALYTICS",
      "dataset": "omaryusuf_events"
    }
  ],
  "observability": {
    "enabled": false
  },
  "vars": {
    "ANALYTICS_ENABLED": "false"
  }
}
