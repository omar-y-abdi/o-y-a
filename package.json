{
  "name": "omaryusuf-se",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Omar Yusuf. En seriöst lekfull plats på internet.",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "dev": "node scripts/build.mjs && node scripts/serve.mjs",
    "preview": "node scripts/serve.mjs",
    "lint": "node scripts/lint.mjs",
    "test": "npm run test:fast && npm run test:slow",
    "test:browser": "python tests/browser.py",
    "test:cms": "npm run test:cms:modules && npm run test:cms:browser",
    "cms:dev": "npm run build && node scripts/cms-dev.mjs",
    "check": "npm run build && npm run lint && npm test",
    "deploy:cloudflare": "wrangler d1 migrations apply CMS_DB --remote && wrangler deploy",
    "deploy": "npm run check && npm run deploy:cloudflare",
    "test:http": "python tests/http_checks.py",
    "test:render": "python tests/browser.py --render-only --screenshots",
    "quality": "bash scripts/quality.sh",
    "edge:check": "npm run build && wrangler deploy --dry-run --outdir artifacts/worker-build",
    "test:cms:modules": "node scripts/test-cms-modules-parallel.mjs",
    "test:cms:compat": "node scripts/test-cms-compat.mjs",
    "test:watch": "node scripts/run-node-tests.mjs watch",
    "test:card-export": "playwright test tests/card-export.spec.mjs --project=chromium",
    "test:cms:browser": "node scripts/test-cms-parallel.mjs",
    "test:cms:smoke": "CMS_MODULE_PROFILE=smoke npm run test:cms:modules",
    "quality:after-check": "SKIP_CHECK=1 bash scripts/quality.sh",
    "edge:check:built": "wrangler deploy --dry-run --outdir artifacts/worker-build",
    "verify:fast": "npm run check:fast && npm run test:cms:smoke",
    "verify:full": "npm run check && npm run quality:after-check && npm run test:cms && npm run test:cms:compat && npm run edge:check:built",
    "test:cms:modules:single": "node scripts/test-cms-modules.mjs",
    "test:public-pages": "playwright test tests/public-pages.spec.mjs --project=chromium",
    "test:web:e2e": "playwright test tests/public-pages.spec.mjs tests/card-export.spec.mjs --project=chromium",
    "test:fast": "node scripts/run-node-tests.mjs fast",
    "test:slow": "node scripts/run-node-tests.mjs slow",
    "check:fast": "npm run build && npm run lint && npm run test:fast"
  },
  "dependencies": {
    "css-tree": "3.2.1",
    "grapesjs": "0.23.6",
    "html-to-image": "1.11.13",
    "image-dimensions": "2.5.1",
    "jose": "6.2.12",
    "parse5": "8.0.1"
  },
  "devDependencies": {
    "esbuild": "0.28.2",
    "miniflare": "5.20260911.0-alpha",
    "wrangler": "4.131.1",
    "@playwright/test": "1.63.0"
  }
}
